{
  "manifest_version": 3,
  "name": "CBT EXAM UT - Exam Browser",
  "version": "1.2",
  "description": "Aplikasi ujian aman untuk Chromebook dengan pemantauan kamera dan anti-kecurangan.",
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "permissions": [
    "tabs",
    "windows",
    "system.display"
  ],
  "host_permissions": [
    "https://smpn1tualang.sch.id/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mulai Ujian CBT UT",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  }
}
