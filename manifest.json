{
  "manifest_version": 3,
  "name": "CBT EXAM UT - Exam Browser",
  "version": "1.5",
  "description": "Aplikasi ujian aman untuk Chromebook dengan pemantauan kamera dan anti-kecurangan.",
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "permissions": [
    "tabs",
    "windows",
    "system.display",
    "declarativeNetRequest",
    "videoCapture"
  ],
  "host_permissions": [
    "https://suo.ut.ac.id/*",
    "https://*.ut.ac.id/*",
    "https://smpn1tualang.sch.id/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://suo.ut.ac.id/*",
        "https://*.ut.ac.id/*"
      ],
      "js": ["anticheat-frame.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "allow_iframe_ut",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mulai Ujian CBT UT",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  }
}
